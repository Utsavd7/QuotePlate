# Copy to .env for local development. Never commit real credentials.

# Restricted application role through Neon's pooled endpoint. Keep the pool at
# five connections for the launch tier. The web app must never use the owner URL.
DATABASE_URL="postgresql://autorfp_app:YOUR_APP_ROLE_PASSWORD@ep-YOUR_PROJECT-pooler.YOUR_REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=10"

# Public application origin. Production must use HTTPS.
NEXTAUTH_URL="http://localhost:3000"

# Generate locally with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Required for public owner signup; optional for existing password-account sign-in.
# New production owners must verify their Google email. Password-only signup is disabled.
# Configure a Google OAuth web client with External audience for public accounts.
# Register the exact callback: <NEXTAUTH_URL>/api/auth/callback/google
# Local example: http://localhost:3000/api/auth/callback/google
# Production: use the canonical HTTPS site origin, and publish the OAuth app.
# The code requests only openid/email/profile. Google Console audience, publishing,
# branding and Workspace admin restrictions must be checked separately.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional public Google Programmable Search Engine ID (cx), available at build time.
# Use the free ad-supported Search Element with supplier domains under Sites to search.
# No API key or billing account. Leave empty to offer external website searches only.
NEXT_PUBLIC_SUPPLIER_SEARCH_ENGINE_ID=""

# No operator email allowlist is required. QUOTEPLATE_PILOT_EMAILS is obsolete.
# Never set QUOTEPLATE_LOCAL_E2E on a deployed site. It enables password signup
# only in production-like tests with BOTH the app and database on loopback URLs.

# Required in the production server/function runtime only. Keep this unset for
# public builds and local development so the build never depends on secrets.
# QUOTEPLATE_RUNTIME_STARTUP_CHECK="1"
