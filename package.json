{
  "name": "quoteplate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postinstall": "prisma generate && node scripts/copy-ocr-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --runInBand --testPathIgnorePatterns=/__tests__/integration/",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:components": "node --test --test-concurrency=1 tests/component/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts",
    "test:e2e:google-live": "AUTH_E2E_LIVE_GOOGLE=1 playwright test tests/e2e/google-live.spec.ts --project=desktop-chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@netlify/blobs": "11.0.2",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tesseract.js-data/eng": "1.0.0",
    "csv-parse": "^7.0.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "node-html-parser": "9.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jest": "30.5.1",
    "jest-environment-node": "30.5.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "overrides": {
    "nodemailer": "9.0.6"
  }
}
