generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MEMBER
}

enum UserAccountState {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum MenuStatus {
  DRAFT
  APPROVED
}

enum ProcurementRequestStatus {
  DRAFT
  OPEN
  AWARDED
  CANCELLED
}

enum SupplierRelationshipType {
  CURRENT
  SELECTED_NEW
  APPLICANT
}

enum SupplierVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Tenant {
  supplierPortals SupplierPortal[]
  supplierCollaborations SupplierCollaboration[]
  supplierDemandShares SupplierDemandShare[]
  id                  String               @id @default(uuid())
  name                String
  addressLine         String
  city                String
  state               String
  pin                 String
  phone               String
  timezone            String               @default("Asia/Kolkata")
  gstin               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  servicePlans        ServicePlan[]
  users               User[]
  menus               Menu[]
  suppliers           Supplier[]
  procurementRequests ProcurementRequest[]
  supplierRequests    SupplierRequest[]
  awards              Award[]
  auditEvents         AuditEvent[]
}

model User {
  id                    String               @id @default(uuid())
  tenantId              String
  name                  String
  email                 String               @unique @db.VarChar(320)
  passwordHash          String?
  googleSubject         String?              @unique
  role                  UserRole             @default(MEMBER)
  accountState          UserAccountState     @default(ACTIVE)
  invitationTokenDigest String?              @unique @db.Char(64)
  invitationExpiresAt   DateTime?
  invitationAcceptedAt  DateTime?
  invitationRevokedAt   DateTime?
  invitedByUserId       String?
  tutorialVersion       Int                  @default(1)
  tutorialStep          Int                  @default(0)
  tutorialSkippedAt     DateTime?
  tutorialCompletedAt   DateTime?
  isActive              Boolean              @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy             User?                @relation("UserInvitations", fields: [tenantId, invitedByUserId], references: [tenantId, id], onDelete: Restrict)
  invitedUsers          User[]               @relation("UserInvitations")
  servicePlans          ServicePlan[]
  menusApproved         Menu[]               @relation("MenuApprover")
  menusCreated          Menu[]               @relation("MenuCreator")
  suppliersVerified     Supplier[]           @relation("SupplierVerifier")
  requestsCreated       ProcurementRequest[] @relation("ProcurementRequestCreator")
  awardsGranted         Award[]              @relation("AwardGrantor")
  auditEvents           AuditEvent[]         @relation("AuditActor")

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@index([tenantId, invitedByUserId])
}

model Menu {
  id               String               @id @default(uuid())
  tenantId         String
  name             String
  status           MenuStatus           @default(DRAFT)
  version          Int                  @default(1)
  document         Json
  sourceText       String?
  approvedAt       DateTime?
  approvedByUserId String?
  createdByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  approvedBy       User?                @relation("MenuApprover", fields: [tenantId, approvedByUserId], references: [tenantId, id], onDelete: Restrict)
  createdBy        User?                @relation("MenuCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  servicePlans     ServicePlan[]
  requests         ProcurementRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, approvedByUserId])
  @@index([tenantId, createdByUserId])
}

model Supplier {
  portals SupplierPortal[]
  collaborations SupplierCollaboration[]
  demandShares SupplierDemandShare[]
  id                   String                     @id @default(uuid())
  tenantId             String
  businessName         String
  contactName          String?
  phone                String?
  whatsappNumber       String?
  email                String?                    @db.VarChar(320)
  addressLine          String?
  city                 String?
  state                String?
  pin                  String?
  gstin                String?
  notes                String?
  relationshipType     SupplierRelationshipType   @default(CURRENT)
  verificationStatus   SupplierVerificationStatus @default(UNVERIFIED)
  applicationRequestId String?
  capabilities         Json
  verifiedAt           DateTime?
  verifiedByUserId     String?
  isActive             Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationRequest   ProcurementRequest?        @relation("SupplierApplicationRequest", fields: [tenantId, applicationRequestId], references: [tenantId, id], onDelete: Restrict)
  verifiedBy           User?                      @relation("SupplierVerifier", fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict)
  supplierRequests     SupplierRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive, businessName])
  @@index([tenantId, applicationRequestId])
  @@index([tenantId, verifiedByUserId])
}

model ProcurementRequest {
  collaborations SupplierCollaboration[]
  id                     String                   @id @default(uuid())
  tenantId               String
  title                  String
  status                 ProcurementRequestStatus @default(DRAFT)
  version                Int                      @default(1)
  menuId                 String?
  sourceRequestId        String?
  items                  Json
  sourcing               Json
  deliveryDetails        Json
  deliveryDate           DateTime                 @db.Date
  quoteDeadline          DateTime
  commercialTerms        String?
  applicationTokenDigest String?                  @unique @db.Char(64)
  applicationExpiresAt   DateTime?
  applicationRevokedAt   DateTime?
  openedAt               DateTime?
  awardedAt              DateTime?
  cancelledAt            DateTime?
  createdByUserId        String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menu                   Menu?                    @relation(fields: [tenantId, menuId], references: [tenantId, id], onDelete: Restrict)
  sourceRequest          ProcurementRequest?      @relation("RequestVersions", fields: [tenantId, sourceRequestId], references: [tenantId, id], onDelete: Restrict)
  revisions              ProcurementRequest[]     @relation("RequestVersions")
  createdBy              User                     @relation("ProcurementRequestCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  servicePlans           ServicePlan[]
  applicantSuppliers     Supplier[]               @relation("SupplierApplicationRequest")
  supplierRequests       SupplierRequest[]
  award                  Award?

  @@unique([tenantId, id])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, menuId])
  @@index([tenantId, sourceRequestId])
  @@index([tenantId, createdByUserId])
}

model SupplierRequest {
  id             String             @id @default(uuid())
  tenantId       String
  requestId      String
  supplierId     String
  tokenDigest    String             @unique @db.Char(64)
  expiresAt      DateTime
  revokedAt      DateTime?
  viewedAt       DateTime?
  quoteRevision  Int                @default(0)
  quoteRevisions Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request        ProcurementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  supplier       Supplier           @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, supplierId])
  @@index([tenantId, supplierId])
}

model Award {
  id                String             @id @default(uuid())
  tenantId          String
  requestId         String             @unique
  rationale         String?
  allocationLines   Json
  supplierSnapshots Json
  deliverySnapshot  Json
  receiving         Json?
  totalPaise        BigInt
  awardedByUserId   String
  createdAt         DateTime           @default(now())
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request           ProcurementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  awardedBy         User               @relation("AwardGrantor", fields: [tenantId, awardedByUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
  @@index([tenantId, awardedByUserId])
}

model AuditEvent {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User?    @relation("AuditActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
}

model RateLimitBucket {
  keyDigest String   @id @db.Char(64)
  count     Int      @default(0)
  resetAt   DateTime
}

model ServicePlan {
  demandShares SupplierDemandShare[]
  id              String @id @default(uuid())
  tenantId        String
  name            String
  version         Int @default(1)
  serviceAt       DateTime
  menuId          String
  menuVersion     Int
  menuSnapshot    Json
  document        Json
  requestId       String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menu            Menu @relation(fields: [tenantId, menuId], references: [tenantId, id], onDelete: Restrict)
  createdBy       User @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  request         ProcurementRequest? @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  revisions       ServicePlanRevision[]
  @@unique([tenantId, id])
  @@index([tenantId, serviceAt])
}

model ServicePlanRevision {
  id        String @id @default(uuid())
  tenantId  String
  planId    String
  version   Int
  document  Json
  createdAt DateTime @default(now())
  plan      ServicePlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, planId, version])
}

model SupplierPortal {
 id String @id @default(uuid())
 tenantId String
 supplierId String
 tokenDigest String @unique @db.Char(64)
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
 supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
 @@unique([tenantId, id])
 @@unique([tenantId, supplierId])
 @@index([tenantId, expiresAt])
}
model SupplierCollaboration {
 id String @id @default(uuid())
 tenantId String
 supplierId String
 requestId String
 version Int @default(1)
 revisions Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
 supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
 request ProcurementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
 @@unique([tenantId, id])
 @@unique([tenantId, supplierId, requestId])
 @@index([tenantId, requestId])
}
model SupplierDemandShare {
 id String @id @default(uuid())
 tenantId String
 supplierId String
 planId String
 planVersion Int
 serviceAt DateTime
 items Json
 withdrawnAt DateTime?
 sharedAt DateTime @default(now())
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
 supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
 plan ServicePlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
 @@unique([tenantId, id])
 @@unique([tenantId, supplierId, planId])
 @@index([tenantId, supplierId, sharedAt])
 @@index([tenantId, planId])
}
